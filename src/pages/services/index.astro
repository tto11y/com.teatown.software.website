---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceCard from "../../components/ServiceCard.astro";

let services = (await getCollection("services", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

services = services.filter(s => s.data?.show);
---

<BaseLayout
  title="Services"
  description="How Teatown helps teams design, build, and ship software and observability solutions."
>
  <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Services</h1>
  <p class="mt-4 max-w-2xl text-lg text-muted">
    What clients get from us
  </p>
  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((s) => (
        <ServiceCard
          href={`/services/${s.id}`}
          title={s.data.title}
          summary={s.data.summary}
        />
      ))
    }
  </div>
</BaseLayout>
