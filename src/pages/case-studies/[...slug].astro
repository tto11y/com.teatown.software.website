---
import { getCollection, getEntries, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const cases = await getCollection("case-studies", ({ data }) => !data.draft);
  return cases.map((study) => ({
    params: { slug: study.id },
    props: { study },
  }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const services = await getEntries(study.data.services);
const dateLabel = study.data.date.toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
});
---

<BaseLayout title={study.data.title} description={study.data.description}>
  <article class="max-w-3xl">
    <a href="/case-studies" class="text-sm font-medium text-brand">
      &larr; All case studies
    </a>

    <p class="mt-4 text-xs font-medium uppercase tracking-wide text-brand">
      {study.data.client}
      {study.data.industry ? ` · ${study.data.industry}` : ""} · {dateLabel}
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-ink sm:text-4xl">
      {study.data.title}
    </h1>
    <p class="mt-4 text-lg text-muted">{study.data.summary}</p>

    {
      study.data.cover && (
        <Image
          src={study.data.cover}
          alt={study.data.title}
          widths={[800, 1200]}
          sizes="(min-width: 768px) 768px, 100vw"
          class="mt-8 aspect-video w-full rounded-xl object-cover"
        />
      )
    }

    {
      study.data.results.length > 0 && (
        <dl class="mt-10 grid gap-6 sm:grid-cols-3">
          {study.data.results.map((r) => (
            <div class="rounded-xl border border-slate-200 p-5">
              <dt class="text-sm text-muted">{r.metric}</dt>
              <dd class="mt-1 text-2xl font-bold text-brand">{r.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose mt-10 text-muted">
      <Content />
    </div>

    {
      services.length > 0 && (
        <div class="mt-10 border-t border-slate-200 pt-6">
          <p class="text-sm font-medium text-ink">Services involved</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {services.map((s) => (
              <a
                href={`/services/${s.id}`}
                class="rounded-full border border-slate-300 px-3 py-1 text-sm text-muted hover:border-brand hover:text-brand"
              >
                {s.data.title}
              </a>
            ))}
          </div>
        </div>
      )
    }
  </article>
</BaseLayout>
