# Teatown — production Caddyfile
# Caddy handles Let's Encrypt automatically (issuance + renewal). No certbot.
# Copy to /etc/caddy/Caddyfile on the box, then: sudo systemctl reload caddy
#
# Replace teatown.es with the real production domain if it differs.

# Canonical — serves the site
teatown.at {
	root * /var/www/teatown
	encode zstd gzip
	file_server

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Astro emits content-hashed asset filenames under /_astro/ — cache hard.
	}
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Astro's static build emits /foo/index.html; Caddy serves it for /foo.
	try_files {path} {path}/ {path}/index.html
}

# www.at -> apex (permanent; www->apex is a settled decision)
www.teatown.at {
	redir https://teatown.at{uri} permanent
}

# .es -> .at (temporary for now; flip to `permanent` once .es folds in for good)
teatown.es, www.teatown.es {
	redir https://teatown.at{uri}
}